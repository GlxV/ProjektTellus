<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/27"
           xmlns:fx="http://javafx.com/fxml/1"
           stylesheets="@../styles/app.css">
    <children>
        <VBox alignment="CENTER" spacing="17" maxWidth="720" styleClass="welcome-panel">
            <padding><Insets top="32" right="32" bottom="32" left="32" /></padding>
            <children>
                <Label text="P R O J E K T T E L L U S" styleClass="brand-label" />
                <Label text="Um planeta. Infinitas possibilidades." styleClass="hero-title" wrapText="true" />
                <Label text="Projeto JavaFX preparado para iniciar a implementacao.&#10;O simulador planetario, os eventos e os saves ainda nao estao disponiveis."
                       styleClass="hero-description" wrapText="true" />
                <Label text="JAVA 25   •   JAVAFX   •   SQLITE   •   POO" styleClass="technology-label" />
            </children>
        </VBox>
    </children>
</StackPane>
